# Server-only. Never commit real values; set them in .env.local locally and in
# Vercel → Project → Settings → Environment Variables for deployments.
RESEND_API_KEY=

# Optional. Sender for contact-form emails once a domain is verified in Resend,
# e.g. "Portfolio <contact@your-domain.com>". Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
