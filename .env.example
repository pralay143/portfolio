# Server-only. Never commit real values; set them in .env.local locally and in
# Vercel → Project → Settings → Environment Variables for deployments.
RESEND_API_KEY=

# Optional. Public base URL for canonical/OG/sitemap/robots URLs.
# Defaults to https://pralay-mehta.vercel.app when empty.
NEXT_PUBLIC_SITE_URL=

# Optional. Google Search Console HTML-tag verification code (content value only).
# Omitted from the page when empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Sender for contact-form emails once a domain is verified in Resend,
# e.g. "Portfolio <contact@your-domain.com>". Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
